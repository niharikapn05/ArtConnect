# Copy to .env and fill in real values (or set these as environment variables on your host).
DB_URL=jdbc:postgresql://localhost:5432/artconnect
DB_USERNAME=postgres
DB_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Payments: "mock" = demo mode, no real money (default). "razorpay" = real payments (use rzp_test_ keys first).
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the Razorpay dashboard webhook (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=
# Only needed when the React app is hosted on a different site than the API, e.g. https://artconnect.example.com
# (comma-separated; defaults to any localhost port for development)
# FRONTEND_ORIGIN=https://artconnect.example.com
# Leave out the demo data in db/sample (recommended in production)
# FLYWAY_LOCATIONS=classpath:db/migration
