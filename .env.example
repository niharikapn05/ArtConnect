# Copy to .env and fill in real values (or set these as environment variables on your host).
DB_URL=jdbc:postgresql://localhost:5432/artconnect
DB_USERNAME=postgres
DB_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Payments: "mock" = demo mode, no real money (default). "razorpay" = real payments (use rzp_test_ keys first).
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the Razorpay dashboard webhook (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=
# Invoices: "outbox" = demo (saved to the outbox/ folder, nothing sent). Real email: EMAIL_PROVIDER=smtp + SMTP_*.
# Real SMS: SMS_PROVIDER=twilio + TWILIO_* (free trial texts verified numbers only). See README "Invoices by email and SMS".
EMAIL_PROVIDER=outbox
SMS_PROVIDER=outbox
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=ArtConnect <you@example.com>
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Twilio trial accounts can only send predefined templates (custom text is rejected): use sms_order_confirmation
# TWILIO_TRIAL_TEMPLATE=sms_order_confirmation
# Website address used in "view invoice" links
# PUBLIC_URL=http://localhost:5173
# Only needed when the React app is hosted on a different site than the API, e.g. https://artconnect.example.com
# (comma-separated; defaults to any localhost port for development)
# FRONTEND_ORIGIN=https://artconnect.example.com
# Leave out the demo data in db/sample (recommended in production)
# FLYWAY_LOCATIONS=classpath:db/migration
